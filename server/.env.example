# Copy to .env and adjust.
PORT=4000
# Always "postgres": the app connects only to the database in DATABASE_URL (e.g. Supabase).
DB=postgres
DATABASE_URL=postgres://scholaris:scholaris@localhost:5432/scholaris
# Supabase: use the "Session pooler" string from the project's Connect dialog, for example
# DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Encryption is switched on automatically for Supabase hosts. To also verify the server
# certificate, download the CA certificate from Database settings and point to it:
# DATABASE_CA_CERT=./supabase-ca.crt
# DATABASE_SSL=require
# DATABASE_SCHEMA=scholaris
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Browser origins allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:5173
SCHOOL_TZ=Asia/Kolkata
