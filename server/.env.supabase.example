# Scholaris API on Supabase (project sahrpmcditfrxqflfjlv). Copy to server/.env.
PORT=4000
DB=postgres
# Supabase dashboard > Connect > Session pooler. Replace <database-password> and <region>.
DATABASE_URL=postgresql://postgres.sahrpmcditfrxqflfjlv:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Keeps Scholaris tables in their own schema, away from other tables in the project
# and out of Supabase's auto-generated REST API.
DATABASE_SCHEMA=scholaris
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SCHOOL_TZ=Asia/Kolkata
